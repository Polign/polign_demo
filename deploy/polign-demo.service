[Unit]
Description=polign Wikipedia search demo (UI + /demo endpoints)
Documentation=https://github.com/Polign/polign_demo
After=network-online.target polign-node.service
Wants=network-online.target
BindsTo=polign-node.service

[Service]
Type=simple
User=polign
Group=polign

# -public is the hosted posture: UI and the read-only /demo endpoints only,
# rate-limited per client, with the query knobs fixed by the operator rather
# than accepted from the browser.
#
# -nprobe is the one number worth tuning here, and it dominates latency. A cell
# at 12.5M passages holds ~3,500 vectors (~11 MB), so the node fetches
# nprobe x 11 MB per query: nprobe 24 measured ~2,500 ms, nprobe 4 measured
# ~25 ms. Raising it did not improve results on this corpus — the top hits were
# identical from 1 to 16 — so the extra IO bought nothing. Revisit if recall
# ever looks like the limiting factor rather than the embedding.
#
# -modes semantic: the BM25 legs (keyword, hybrid) read every lexical segment
# per query, so their memory scales with the corpus's total text rather than
# with the query. At 12.5M passages that is ~10 GB of lseg per query, which
# OOM-kills this 2 GB node — measured, not theoretical. Re-enable them once
# SearchText streams its segments, or on a node sized for the whole lex index.
#
# -dir holds only the embedding model (~129 MB) and corpus.json. The passages
# live in S3, reached through the node.
#
# The limit has to clear the resident matrix (63,091 tokens x 512 dims x 4 B =
# 129 MB) plus the vocabulary map and per-request garbage. 400 MiB is
# comfortable; 256 MiB is not, and the two services together must still fit the
# box (see polign-node.service).
Environment=GOMEMLIMIT=400MiB
ExecStart=/opt/polign/bin/polign-demo \
    -public \
    -modes semantic \
    -http 127.0.0.1:23100 \
    -node http://127.0.0.1:23000 \
    -dir /opt/polign/data \
    -collection wikipedia \
    -nprobe 4 \
    -k 8

Restart=always
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
