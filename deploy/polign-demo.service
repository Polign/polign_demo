[Unit]
Description=polign Wikipedia search demo (UI + /demo endpoints)
Documentation=https://github.com/Polign/polign_demo
After=network-online.target polign-node.service polign-embedserve.service
Wants=network-online.target
# BindsTo stops this app if the node goes away — it has nothing to serve without
# one. PartOf is what brings it back: BindsTo propagates a *stop* but not a
# restart, so upgrading the node binary took the site down and left it down
# until someone noticed. With both, `systemctl restart polign-node` cycles
# the app too.
BindsTo=polign-node.service
PartOf=polign-node.service

[Service]
Type=simple
User=polign
Group=polign

# -embed-addr points at the embedding sidecar, which must run the model that
# embedded this collection. The pairing is not optional: a vector from another
# model is a point in a different space, so the query would return near-noise
# rather than an error. The app refuses to start if the sidecar is not
# answering.
#
# -dir holds only corpus.json and examples.txt — descriptive data for the UI.
# The app loads no model of its own, which is why GOMEMLIMIT here is tiny.
#
# -nprobe 8: measured, not assumed. Quality is flat from nprobe 8 to 64 on the
# 30-query evaluation set (MRR 0.336 at every value), so IVF recall is not what
# limits this demo — the embedder is. 8 is therefore the cheapest setting that
# costs nothing in quality. Raise it only if a measurement says recall binds.
#
# -modes: all three are affordable now. The BM25 legs used to read every lexical
# segment per query — ~10 GB at this corpus size, a measured OOM on this 2 GB
# node — which is why the BM25 legs were once unusable here. The lexical index
# now supports
# ranged reads (postings by term rather than whole segments), so a text query
# reads its terms: measured 294 MB peak RSS against the OOM it used to cause.
#
# Semantic is listed first because the first entry is the default, and it is the
# best of the three here by measurement, not by assumption: on the 30-query
# evaluation set semantic scores MRR 0.336, hybrid 0.168 and keyword 0.024. BM25
# surfaces disambiguation and list pages (short, dense in the query terms) since
# this analyzer has no stop-word handling and there is no title-field weighting,
# so reciprocal-rank fusion pulls the good semantic ranking toward the poor
# lexical one. Keyword and hybrid stay selectable for comparison; title-weighted
# BM25 is the work that would make hybrid the right default.
#
Environment=GOMEMLIMIT=200MiB
ExecStart=/opt/polign/bin/polign-demo \
    -public \
    -modes semantic,keyword,hybrid \
    -http 127.0.0.1:23100 \
    -node http://127.0.0.1:23000 \
    -embed-addr http://127.0.0.1:23200 \
    -embed-dim 384 \
    -dir /opt/polign/data \
    -collection wikipedia_bge \
    -nprobe 8 \
    -k 8

Restart=always
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
