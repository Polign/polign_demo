[Unit]
Description=polign_db serving node (cold-first, read-only)
Documentation=https://github.com/Polign/polign_demo
After=network-online.target
# Pull the web app back in after an automatic crash/OOM restart as well as an
# explicit restart. The app's BindsTo/PartOf alone does not start an inactive app.
Wants=network-online.target polign-demo.service

[Service]
Type=simple
User=polign
Group=polign

# The node holds no corpus; every flag below is there to keep it that way. Left
# alone, -store expands into a full read-write deployment that rebuilds the
# index in RAM at boot, which a 2 GB box cannot survive.
#
# The 2 GB host also runs the Memory and Discovery demos. GOMEMLIMIT is a soft
# Go runtime target, not an RSS ceiling. Leave headroom for runtime overhead and
# file pages, reclaim above MemoryHigh, and bound this unit with MemoryMax so a
# spike cannot consume the whole host. Disk-cache pages are reclaimable; the
# 256 MiB in-memory segment cache is included in the Go memory target.
#
# Put AWS_REGION in the same region as the bucket. A store in another region
# still answers, it just pays a cross-region round trip on every cold cell, and
# the cold path is the whole point of this deployment.
Environment=GOMEMLIMIT=512MiB
MemoryAccounting=yes
MemoryHigh=640M
MemoryMax=768M
Environment=AWS_REGION=REPLACE_REGION
ExecStart=/opt/polign/bin/polign-server-0.14.0 \
    -telemetry-id-file /var/lib/polign/telemetry-install-id \
    -store s3://REPLACE_BUCKET/polign \
    -read-only \
    -cold-first \
    -hot-max 0 \
    -persist=false \
    -maintain 0 \
    -tail-fresh=false \
    -http 127.0.0.1:23000 \
    -grpc 127.0.0.1:23001 \
    -disk-cache-dir /var/lib/polign/disk-cache \
    -disk-cache-bytes 6442450944 \
    -segment-cache-bytes 268435456 \
    -segment-refresh 5m \
    -hedge-reads 150ms

Restart=always
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/polign
StateDirectory=polign

[Install]
WantedBy=multi-user.target
