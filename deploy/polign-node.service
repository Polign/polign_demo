[Unit]
Description=polign_db serving node, v2 collection (cold-first, read-only)
Documentation=https://github.com/Polign/polign_demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=polign
Group=polign

# Same cold-first posture as polign-node.service — the node holds no corpus,
# every flag below keeps it that way. See that file for what each one prevents.
#
# What differs on this host is the memory split. The v1 box ran one Go app whose
# static embedding matrix was 129 MB resident; here the query embedder is a
# separate Python process (polign-embedserve.service, ~380 MiB) because the
# model is ONNX. So the node's ceiling comes down to leave room for it:
#
#   node (this)      1000 MiB limit, ~420 MiB typical under queries
#   embedserve        ~380 MiB resident
#   demo app           ~30 MiB (it no longer loads any model of its own)
#
# on a 2 GB box. The disk cache is what keeps the node's RSS flat as the corpus
# grows: cells land on local disk, not in the heap.
Environment=GOMEMLIMIT=1000MiB
Environment=AWS_REGION=us-east-1
ExecStart=/opt/polign/bin/polign-server \
    -store s3://polign-demo-wiki-en/polign \
    -restore-stores "" \
    -hot-max 0 \
    -persist=false \
    -maintain 0 \
    -tail-fresh=false \
    -log-stores "" \
    -http 127.0.0.1:23000 \
    -grpc 127.0.0.1:23001 \
    -disk-cache-dir /var/lib/polign/disk-cache \
    -disk-cache-bytes 6442450944 \
    -segment-refresh 5m \
    -hedge-reads 150ms

Restart=always
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/polign
StateDirectory=polign

[Install]
WantedBy=multi-user.target
