[Unit]
Description=polign_db serving node (cold-first, read-only)
Documentation=https://github.com/Polign/polign_demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=polign
Group=polign

# The serving node holds no corpus. Every flag below exists to keep it that
# way — the -store preset would otherwise turn this box into a full read-write
# node that restores the whole collection into RAM on boot.
#
#   -restore-stores ""   do not rebuild the in-memory index at boot. Without
#                        this the node loads all 6M vectors (~6 GB) on start.
#   -hot-max 0           never promote a collection to the in-memory hot tier.
#                        Promotion transiently materializes the full index.
#   -persist=false       this node does not consume the write log; the build
#                        host did that.
#   -maintain 0          index maintenance runs on the build host, not here.
#   -tail-fresh=false    a read-only demo has no writes to catch up on, and the
#                        log tail follower costs a few hundred MB of RSS.
#   -log-stores ""       no write log at all, for the same reason.
#
# What is left is the cold read path: manifest + centroids resident, cells
# fetched from S3 per query and cached on local disk.
Environment=GOMEMLIMIT=1400MiB
Environment=AWS_REGION=us-east-1
ExecStart=/opt/polign/bin/polign-server \
    -store s3://REPLACE_BUCKET/polign \
    -restore-stores "" \
    -hot-max 0 \
    -persist=false \
    -maintain 0 \
    -tail-fresh=false \
    -log-stores "" \
    -http 127.0.0.1:23000 \
    -grpc 127.0.0.1:23001 \
    -disk-cache-dir /var/lib/polign/disk-cache \
    -disk-cache-bytes 6442450944 \
    -segment-refresh 5m \
    -hedge-reads 150ms

Restart=always
RestartSec=5s

# The node is reachable only over loopback; Caddy and the demo app are the
# only things that talk to it.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/polign
StateDirectory=polign

[Install]
WantedBy=multi-user.target
