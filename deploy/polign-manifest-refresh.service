[Unit]
Description=Fold build progress into the demo's corpus.json
Documentation=https://github.com/Polign/polign_demo

[Service]
Type=oneshot
Environment=AWS_REGION=us-east-1
ExecStart=/opt/polign/bin/refresh-manifest.sh

# Writes one file in the app's data directory and nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/polign/data
