[Unit]
Description=Refresh the demo's corpus manifest from the build's published progress

[Timer]
# Every 5 minutes while a build is loading. The app re-reads corpus.json on
# mtime change, so this costs one small S3 GET and no restart. Once the build
# finishes, the publisher stops updating progress.json and the refresh settles
# on the final count.
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
