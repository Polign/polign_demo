# TLS terminates here and only the app is exposed — the node (23000) and the embedding sidecar (23200)
# listen on loopback and are never reachable from outside this host.
#
# The DNS record must be DNS-only (grey cloud on Cloudflare), or the HTTP-01
# challenge cannot reach Caddy.

# Both names serve the same site. demo.polign.com is the public entry point;
# demowiki2.polign.com stays valid so links handed out during the build keep
# working, and so a future cutover has a name to stage against.
demo.polign.com, demowiki2.polign.com {
	encode zstd gzip

	# The app reads the leftmost X-Forwarded-For hop for its per-client rate
	# limit. Caddy appends the client IP to that header by default, so no
	# header_up directive is needed (adding one makes Caddy warn).
	reverse_proxy 127.0.0.1:23100

	header {
		# The demo serves its own inline CSS/JS and links out to Wikipedia.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/demowiki2.polign.com.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
